{
  "name": "digger-bombar-3d",
  "private": true,
  "version": "2.0.0",
  "description": "ДИГГЕР: Бомбарь 3D — стелс от первого лица в заброшенном советском бомбоубежище",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=esm --target=es2020 --outfile=js/digger3d.js",
